# Google OAuth Web client ID — must match the backend's GOOGLE_CLIENT_ID.
# Vite embeds VITE_* variables in the public bundle, so never put secrets here.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional: override the GA4 measurement ID baked into src/lib/ga.js
# (G-0B78W40WRH). Public by design. Only active in production builds on
# the real domain.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
